{
  "name": "xiaonian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "dev": "pnpm --filter @xiaonian/gateway dev",
    "db:migrate": "pnpm --filter @xiaonian/gateway db:migrate",
    "db:reset": "pnpm --filter @xiaonian/gateway db:reset"
  }
}
