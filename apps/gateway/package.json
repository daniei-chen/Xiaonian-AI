{
  "name": "@xiaonian/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "dev": "node --watch --enable-source-maps dist/index.js",
    "start": "node --enable-source-maps dist/index.js",
    "db:migrate": "node dist/db/migrate.js",
    "db:reset": "node dist/db/reset.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "@xiaonian/adapters": "workspace:*",
    "@xiaonian/protocol": "workspace:*",
    "fastify": "^5.1.0",
    "jose": "^5.9.0",
    "pino": "^9.5.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "pino-pretty": "^13.0.0",
    "typescript": "^5.7.0"
  }
}
