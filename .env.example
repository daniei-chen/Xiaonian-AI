# 本地开发环境变量 —— 不入库（见 .gitignore）
# 默认 provider：deepseek
DEEPSEEK_API_KEY=你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：第三方 provider（默认不启用，缺省回落到 deepseek）
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=

# Gateway
GATEWAY_PORT=8788
JWT_SECRET=dev-only-change-me
DATABASE_URL=postgres://xiaonian:xiaonian_dev@127.0.0.1:5432/xiaonian
# 未装 Docker 时用 PGlite：sqlite://./.data/pg
